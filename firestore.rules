rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Dữ liệu cá nhân: Chỉ chính chủ mới có quyền Đọc & Ghi
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Kho từ vựng Master Chunks hệ thống: Khách và User đều đọc được, cấm client sửa
    match /chunks/{chunkId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. Decks cộng đồng
    match /decks/{deckId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // 4. Cache phụ đề YouTube công khai: cho phép đọc, tạo mới và cập nhật; tuyệt đối cấm xóa
    match /youtube_transcripts/{videoId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 5. Kho IPA được làm giàu tự động (runtime-discovered từ Free Dictionary API)
    //    - Đọc: công khai (dữ liệu không nhạy cảm)
    //    - Tạo mới: cho phép nếu data hợp lệ (có ipa là string, không rỗng)
    //    - Cập nhật/Xóa: tuyệt đối cấm (bảo toàn dữ liệu đã tích lũy)
    match /ipa_enriched/{word} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['ipa', 'addedAt'])
                    && request.resource.data.ipa is string
                    && request.resource.data.ipa.size() > 0
                    && request.resource.data.ipa.size() < 120;
      allow update, delete: if false;
    }
  }
}
